# Infrastructure secrets for docker compose – copy to .env.docker (git-ignored).
# Application settings live in backend/.env.docker (see backend/.env.docker.example);
# the frontend needs no runtime secrets (build-time values: frontend/.env.production).
POSTGRES_PASSWORD=change-me
# Password of hrms_app, the least-privilege role the API connects as (created by the migrate service).
APP_DB_PASSWORD=change-me-too
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=hrms-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
