# Frontend environment (copy to .env for local development).
# VITE_* values are embedded in the browser bundle – never put secrets here.

# Base path of the REST API as seen by the browser (same origin; proxied in dev, nginx in Docker)
VITE_API_BASE_URL=/api/v1
# Product name shown in the browser title
VITE_APP_NAME=HRMS

# ── Dev server only (not exposed to the browser) ──
DEV_SERVER_PORT=5173
# Backend the Vite dev server proxies /api to
DEV_API_PROXY_TARGET=http://localhost:3000
