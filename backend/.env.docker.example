# Backend runtime environment for docker compose – copy to .env.docker (git-ignored).
# DB_* (database configuration) and REDIS_URL are supplied by docker-compose.yml.
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1
# Browsers accept Secure cookies on http://localhost; always true behind TLS.
COOKIE_SECURE=true
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
MFA_ISSUER=HRMS
# Super Admins must use two-factor sign-in; false only for local test automation (refused in production).
PLATFORM_MFA_REQUIRED=true
ALLOW_ORGANIZATION_SIGNUP=false
DEFAULT_PLAN_CODE=starter
# SendGrid (required: this stack runs with NODE_ENV=production)
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=no-reply@your-domain.com
SENDGRID_FROM_NAME="HRMS"
SENDGRID_SANDBOX_MODE=false
# Employee documents (S3 credentials come from the AWS chain: instance role or AWS_* variables)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# First Super Admin, created by the bootstrap step if missing (remove after first start)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
