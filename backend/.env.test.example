# Backend test environment – copy to .env.test (git-ignored). Used by integration tests (Jest) and Playwright.
# The database name MUST contain "test": the suites truncate every table.
NODE_ENV=test
PORT=3001
CORS_ORIGINS=http://localhost:5174
APP_URL=http://localhost:5174
TRUST_PROXY=0
# Database Configuration (DB_NAME must contain "test")
DB_NAME=hrms_test
DB_USER=hrms
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
REDIS_URL=redis://localhost:6379
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
COOKIE_SECURE=false
MFA_ISSUER=HRMS-Test
ALLOW_ORGANIZATION_SIGNUP=true
DEFAULT_PLAN_CODE=starter
# Tests never send email (no SENDGRID_API_KEY): messages are captured in memory.
SENDGRID_FROM_EMAIL=no-reply@hrms.local
SENDGRID_FROM_NAME="HRMS"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads-test

# Super Admin seeded for Playwright end-to-end tests
SUPERADMIN_EMAIL=superadmin@e2e.test
SUPERADMIN_PASSWORD=CHANGE_ME
# Organization owner the Playwright setup signs up (it becomes the Organization Admin of "Acme Technologies")
E2E_ORG_ADMIN_EMAIL=admin@acme.test
E2E_ORG_ADMIN_PASSWORD=CHANGE_ME
