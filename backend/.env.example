# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in email links)
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs)
TRUST_PROXY=0

# ── Database Configuration ───────────────────────────────
# Use a dedicated least-privilege role that owns the database (not the postgres superuser).
DB_NAME=hrms_dev
DB_USER=hrms
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432
# true = require TLS with certificate verification (managed/cloud databases). Required in production unless
# DB_ALLOW_INSECURE=true (only for a database on a private network, e.g. the Docker stack).
DB_SSL=false
# Optional split: migrations run as the schema owner below, the API as DB_USER with row access only
# (`npm run db:migrate` creates DB_USER if missing and keeps its grants current).
# DB_MIGRATION_USER=hrms_owner
# DB_MIGRATION_PASSWORD=CHANGE_ME

# ── Redis (rate limiting store / BullMQ – requires Redis >= 6.2) ──
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# 32 bytes, base64. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Key rotation: bump the version with a new key, list the old one here until `npm run db:reencrypt` reports all current.
DATA_ENCRYPTION_KEY_VERSION=1
# DATA_ENCRYPTION_PREVIOUS_KEYS=1:<old base64 key>
# env: the keys above are plain base64 keys. aws-kms (envelope encryption, recommended in production): they are
# KMS-encrypted data keys from `aws kms generate-data-key --key-id <key> --key-spec AES_256 \
#   --encryption-context app=hrms,purpose=data-encryption-key` (CiphertextBlob), decrypted at startup.
DATA_ENCRYPTION_KEY_SOURCE=env
# KMS_REGION=ap-south-1

# Audit/login archives are write-once for this many days (S3 Object Lock; enable Object Lock on the bucket).
AUDIT_ARCHIVE_RETENTION_DAYS=2557
AUDIT_ARCHIVE_LOCK_MODE=COMPLIANCE

# Browser notifications (Web Push): `npx web-push generate-vapid-keys`; leave both empty to switch them off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@your-domain.com

# WhatsApp notifications: off, log (server log; development) or meta (WhatsApp Business Cloud API).
# Templates must be approved in Meta Business Manager: WHATSAPP_TEMPLATE takes {{1}} title and {{2}} link,
# WHATSAPP_CODE_TEMPLATE (authentication category) takes {{1}} the verification code.
WHATSAPP_PROVIDER=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=hrms_notification
WHATSAPP_CODE_TEMPLATE=hrms_verification_code
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Observability ────────────────────────────────────────
# Prometheus scrapes GET /api/v1/metrics with "Authorization: Bearer <token>" (24+ characters; required in production).
METRICS_TOKEN=
# OpenTelemetry tracing (OTLP/HTTP); leave empty to switch it off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to true behind HTTPS (always true in production)
COOKIE_SECURE=false
MFA_ISSUER=HRMS
# Super Admins must use two-factor sign-in; false only for local test automation (refused in production).
PLATFORM_MFA_REQUIRED=true
# Reject new passwords found in data breaches (Have I Been Pwned; only a 5-character hash prefix is sent).
PASSWORD_BREACH_CHECK=true

# Allow public organization self-registration
ALLOW_ORGANIZATION_SIGNUP=true
# Plan assigned to self-registered organizations
DEFAULT_PLAN_CODE=starter

# ── Mail ─────────────────────────────────────────────────
# SendGrid API key (https://app.sendgrid.com/settings/api_keys – "Restricted Access" with Mail Send only).
# Leave empty in development to print emails to the API log instead of sending them.
SENDGRID_API_KEY=
# Logged emails hide link query strings (one-time tokens); true prints them in full for local testing.
MAIL_LOG_LINKS=false
# Must be a verified Sender Identity (or on an authenticated domain) in SendGrid.
SENDGRID_FROM_EMAIL=no-reply@your-domain.com
SENDGRID_FROM_NAME="HRMS"
# true = SendGrid validates requests but delivers nothing
SENDGRID_SANDBOX_MODE=false

# File storage for employee documents: local (development) or s3 (required in production).
# S3 credentials come from the standard AWS chain (environment, profile or instance role), never from this file.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
S3_BUCKET=
S3_REGION=
# Only for S3-compatible stores such as MinIO or Cloudflare R2
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Super Admin (created by `npm run db:seed` if missing) ──
# Organizations are not seeded: owners sign up at /register and become Organization Admin.
SUPERADMIN_EMAIL=superadmin@hrms.local
SUPERADMIN_PASSWORD=CHANGE_ME
